<launch>
    <!-- First Turtlesim and Controller -->
    <node pkg="turtlesim" exec="turtlesim_node" name="turtlesim1"/>

    <node pkg="turtle_controller" exec="turtle_controller" name="turtle_controller1">
        <param from="$(find-pkg-share turtle_controller)/config/turtle_params.yaml"/>
    </node>

    <!-- Second Turtlesim and Controller -->
    <node pkg="turtlesim" exec="turtlesim_node" name="turtlesim2" namespace="sim2">
        <remap from="/sim2/turtle1/cmd_vel" to="/turtle2/cmd_vel"/>
        <remap from="/sim2/turtle1/pose" to="/turtle2/pose"/>
        <remap from="/sim2/turtle1/set_pen" to="/turtle2/set_pen"/>
    </node>

    <node pkg="turtle_controller" exec="turtle_controller" name="turtle_controller2">
        <param name="color_1" value="[0, 255, 0]"/>
        <param name="color_2" value="[255, 0, 255]"/>
        <param name="velocity_left" value="2.0"/>
        <param name="velocity_right" value="3.0"/>
        <param name="angular_velocity_left" value="1.5"/>
        <param name="angular_velocity_right" value="2.5"/>
        <remap from="/turtle1/cmd_vel" to="/turtle2/cmd_vel"/>
        <remap from="/turtle1/pose" to="/turtle2/pose"/>
        <remap from="/turtle1/set_pen" to="/turtle2/set_pen"/>
    </node>
</launch>
